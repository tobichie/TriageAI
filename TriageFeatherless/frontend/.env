VITE_API_URL=http://<host_domain/ip>:8000
VITE_DASHBOARD_API_URL=http://<host_domain/ip>:8001
# Only if behind a reverse proxy/traffic to host:8000 is routed to /api and traffic to host:8001 is routed to /dashboard-api
# Otherwise you need to use:
# VITE_API_URL=http://localhost:8000
# VITE_DASHBOARD_API_URL=http://localhost:8001

# set the allowed hosts to your device ip/domain, for example 
VITE_ALLOWED_HOSTS=<host_domain/ip>,localhost,127.0.0.1
